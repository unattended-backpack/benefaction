# Deployment configuration for benefaction.
# Copy to .env and modify as needed.

# Private key for deployment. If set, takes precedence over MNEMONIC.
# PRIVATE_KEY=0x...

# Wallet mnemonic for deployment transactions.
MNEMONIC="faith faith faith faith faith faith faith grace grace grace grace grace"

# Mnemonic account index (account derivation path index).
MNEMONIC_INDEX=0

# RPC endpoint URL.
RPC_URL=http://rpc.sacristy.local

# Contract verifier service.
VERIFIER=blockscout

# Verifier API URL.
VERIFIER_URL=http://api.blockscout.sacristy.local/api/

# Deployment configuration.
# Each contract deployment requires a salt and expected address.

# Test20 token deployment.
TOKEN_SALT=0x70abf01908c8380051063f000000000000000000000000000000000000000000
TOKEN_EXPECTED_ADDRESS=0x0000000003228109298773F89B478ccBB25Da484

# ContinuousClearingAuctionFactory deployment.
FACTORY_SALT=0xfa10d7d29da84800a80ebb000000000000000000000000000000000000000000
FACTORY_EXPECTED_ADDRESS=0x00000000FA17AD8cCC8A83000401f950DFe40e80

# AuctionStateLens deployment.
LENS_SALT=0x20879571769e8b00a6438a000000000000000000000000000000000000000000
LENS_EXPECTED_ADDRESS=0x000000004B8F575fa0c1202C5476FAA45dCf7fCa

# ContinuousClearingAuction deployment.
CCA_SALT=0x6ace85334c6f08011efa5b000000000000000000000000000000000000000000
CCA_EXPECTED_ADDRESS=0x00000000E8dC58878AaCEeFD5f2594fFB4d1419D

# Deployed CCA address (set after deployment, used by PrepareCCA and SubmitBid).
CCA_ADDRESS=0x00000000E8dC58878AaCEeFD5f2594fFB4d1419D

# ContinuousClearingAuction parameters.
CCA_TOKEN=0x0000000003228109298773F89B478ccBB25Da484
CCA_AUCTION_SUPPLY=500000000000000000000000000
CCA_CURRENCY=0x0000000000000000000000000000000000000000
CCA_TOKENS_RECIPIENT=0x0000000003228109298773F89B478ccBB25Da484
CCA_FUNDS_RECIPIENT=0x0000000003228109298773F89B478ccBB25Da484
CCA_START_BLOCK=300
CCA_END_BLOCK=3300
CCA_CLAIM_BLOCK=6000
CCA_TICK_SPACING=7937103036892840872925
CCA_VALIDATION_HOOK=0x0000000000000000000000000000000000000000
CCA_FLOOR_PRICE=79371030368928408729250
CCA_REQUIRED_CURRENCY_RAISED=10000000000000000000

# Auction steps: parallel arrays of MPS values and block deltas.
# Each step is (mps, blockDelta) and sum(mps * blockDelta) must equal 1e7.
# Example: 333*300 + 3297*2699 + 1001497*1 = 10000000.
CCA_AUCTION_STEPS_MPS=333,3297,1001497
CCA_AUCTION_STEPS_BLOCKS=300,2699,1

# Bid submission parameters.
BID_VALUE=1000000000000000000
BID_TICK_OFFSET=1
